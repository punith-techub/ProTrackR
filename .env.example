# ========================================================
# PROTRACKR PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port
PORT=3000

# Secret Key for Signing JWT Session Tokens
JWT_SECRET=protrackr_super_secret_production_key_change_me_987654321

# ========================================================
# FREE EMAIL OTP (NODEMAILER) CONFIGURATION
# ========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="ProTrackR" <your_gmail_address@gmail.com>

# ========================================================
# FREE GOOGLE SIGN-IN CONFIGURATION (GOOGLE IDENTITY SERVICES)
# ========================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ========================================================
# FREE SUPABASE CONFIGURATION (POSTGRES + REALTIME + RLS)
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy Project URL and Project API Key (anon/public)
# ========================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
